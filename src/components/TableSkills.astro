---
interface Props {
	head?: string;
	skills?: string[];
	headColor?: string;
}

const { head, skills = [], headColor = 'var(--accent-regular)' } = Astro.props;
---

<div class="skill-card">
	<h3 class="skill-card-title">{head}</h3>
	<ul class="skill-list">
		{skills.map((skill) => <li class="skill-chip">{skill}</li>)}
	</ul>
</div>

<style define:vars={{ headColor }}>
	.skill-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.skill-card-title {
		align-self: flex-start;
		margin: 0;
		padding: 0.3rem 0.9rem;
		border-radius: 999rem;
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--gray-999);
		background-color: var(--headColor);
	}

	.skill-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.skill-chip {
		padding: 0.4rem 0.9rem;
		border: 1px solid var(--gray-800);
		border-radius: 999rem;
		font-size: var(--text-sm);
		color: var(--gray-200);
		background-color: var(--gray-999_40);
		white-space: nowrap;
	}
</style>
